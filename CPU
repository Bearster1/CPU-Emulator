def readFile(RAM, fileName):
	with open(fileName, 'r') as file:
		lineNumber = 0
		for line in file:
			line = line.strip()
			if '#' in line:
				comment = line.find('#')
				line = line[0:comment]
			line = line.replace(' ', '')
			if line[0:2] == '0x':
			   	line = line.replace('0x', '')
			if line[len(line)-1] == ',':
				line = line.replace(',', '')
			if line == "":
				continue
			RAM.append(int(line, 16))

def loadFile(RAM):
	fileName = input("Enter the name of the file that you would like to execute (Without extension - it is a .bin file): ")
	fileName += ".bin"
	readFile(RAM, fileName)

